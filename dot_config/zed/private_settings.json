// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"theme": "Ayu Dark",
	"features": {
		"edit_prediction_provider": "zed"
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"ui_font_size": 20,
	"buffer_font_size": 20,
	"edit_predictions": {
		"mode": "eager"
	},
	"file_types": {
		"Dockerfile": ["Dockerfile", "Dockerfile.*"],
		"JSON": ["json", "jsonc", "*.code-snippets"]
	},
	"agent": {
		"inline_assistant_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-4-latest"
		},
		"always_allow_tool_actions": true,
		"preferred_completion_mode": "burn",
		"default_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4"
		}
	},
	"agent_servers": {
		"Goose 🪿": {
			"command": "goose",
			"args": ["acp"],
			"env": {}
		}
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		},
		"pyright": {
			"settings": {
				"python.analysis": {
					"diagnosticMode": "workspace",
					"typeCheckingMode": "strict"
				},
				"python": {
					"pythonPath": ".venv/bin/python"
				}
			}
		},
		"ruff": {
			"initialization_options": {
				"settings": {
					// Ruff server settings goes here
					"lineLength": 88,
					"lint": {
						"extendSelect": ["I"]
					}
				}
			}
		}
	},
	"code_actions_on_format": {
		"source.fixAll.biome": true,
		"source.organizeImports.biome": true
	},
	"languages": {
		"Prisma": {
			"tab_size": 4
		},
		"JavaScript": { "formatter": { "language_server": { "name": "biome" } } },
		"TSX": { "formatter": { "language_server": { "name": "biome" } } },
		"JSON": { "formatter": { "language_server": { "name": "biome" } } },
		"JSONC": { "formatter": { "language_server": { "name": "biome" } } },
		"CSS": { "formatter": { "language_server": { "name": "biome" } } },
		"Markdown": {
			"soft_wrap": "editor_width"
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"inlay_hints": {
				"enabled": true,
				"show_parameter_hints": false,
				"show_other_hints": true,
				"show_type_hints": true
			}
		},
		"Python": {
			"language_servers": ["ruff", "pyright", "ty"],
			"format_on_save": "on",
			"formatter": [
				{
					"language_server": {
						"name": "ruff"
					}
				},
				{
					"code_actions": {
						// Fix all auto-fixable lint violations
						"source.fixAll.ruff": true,
						// Organize imports
						"source.organizeImports.ruff": true
					}
				}
			]
		}
	}
}
