{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
echo "Setting up your Mac..."

# Ask for sudo once up front and keep it alive for the whole run. brew bundle
# hides installer output, so a sudo re-prompt from a .pkg cask (zoom, teams)
# would otherwise look like a silent hang.
sudo -v
while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &

echo "Enable File Vault"
sudo fdesetup enable || true

# Update Homebrew recipes
brew update

# Mac App Store installs hang indefinitely when not signed in to the App Store,
# so mas entries are opt-in: rerun with INSTALL_MAS=1 after signing in.
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"
if [ "${INSTALL_MAS:-0}" != "1" ]; then
  HOMEBREW_BUNDLE_MAS_SKIP="$(sed -nE 's/^mas .*id: *([0-9]+).*/\1/p' "$BREWFILE" | tr '\n' ' ')"
  export HOMEBREW_BUNDLE_MAS_SKIP
  echo "Skipping Mac App Store apps (set INSTALL_MAS=1 to include): $HOMEBREW_BUNDLE_MAS_SKIP"
fi

# Install all our dependencies with bundle (See Brewfile)
brew bundle --verbose --file "$BREWFILE"

# Install Rust
if test ! $(which rustup); then
  /bin/sh -c "$(curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs)"
fi

# Install nvm (node)
if test ! $(which nvm); then
  /bin/sh -c "$(curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh)"
fi

# Install TPM
if [ ! "$(ls -A ~/.tmux/plugins/tpm 2>/dev/null)" ]; then
  git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

# Install Python uv
curl -LsSf https://astral.sh/uv/install.sh | sh

# Create a projects directory if it doesn't exist
if [ ! -d "$HOME/workspace" ]; then
 mkdir $HOME/workspace
fi

{{ end -}}
